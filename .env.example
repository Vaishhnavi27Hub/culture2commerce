# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit real keys.

# --- Qloo (required for live data; the app falls back to recorded samples without it) ---
QLOO_API_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=
# live = call the real API (default). recorded = always use the bundled sample snapshots.
QLOO_MODE=live
# Maximum Qloo calls one run may make (protects the monthly quota). A full partner run uses about 30 to 45.
QLOO_RUN_CALL_BUDGET=70

# --- Optional free LLM for narrative polish only (scores never depend on it) ---
# none | gemini | openai_compatible
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Developer status page at /dev (always on in development) ---
ENABLE_DEV_PAGE=false
